# ==============================================================================
# CLINILYNC — Global Healthcare Technology Platform
# Environment Configuration Template (.env.example)
#
# Guidelines:
# - Copy this file to .env for local development.
# - NEVER commit secrets or real credentials to source control.
# - Cloudflare and GitHub Secrets handle staging/production variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Platform Environment
# ------------------------------------------------------------------------------
NODE_ENV="development" # Options: development | staging | production | test
PORT=3000
HOST="0.0.0.0"
APP_URL="http://localhost:3000"
TRUST_PROXY="false" # Set true only when the API accepts traffic exclusively through a trusted reverse proxy.
ALLOW_DEMO_SEED="false" # Keep false for staging/production; seed synthetic fixtures explicitly when appropriate.

# ------------------------------------------------------------------------------
# Relational Database (PostgreSQL)
# ------------------------------------------------------------------------------
# For PostgreSQL-backed development and integration testing, set an isolated
# database connection string. The in-process adapter is test-only and does not
# prove PostgreSQL constraints, transaction isolation, or migration correctness.
# For staging and production, use the standard PostgreSQL connection string:
# DATABASE_URL="postgres://username:password@postgres-host:5432/clinilync_db?sslmode=require"
DATABASE_URL=""
DATABASE_SSL="false"
DB_MAX_CONNECTIONS=20

# ------------------------------------------------------------------------------
# Authentication & Cryptographic Session Security
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for signing sessions and verification tokens.
SESSION_SECRET="change-this-to-a-cryptographically-secure-random-string-in-production"
SESSION_EXPIRY_SECONDS=86400 # 24 hours

# ------------------------------------------------------------------------------
# Cloudflare Infrastructure
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id_placeholder"
CLOUDFLARE_ZONE_ID="your_cloudflare_zone_id_placeholder"
CLOUDFLARE_R2_BUCKET="clinilync-documents-storage"

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------
CORS_ORIGINS="http://localhost:3000,https://clinilync.com"
RATE_LIMIT_PER_MINUTE=120

# ------------------------------------------------------------------------------
# Optional External Integrations (Placeholders for Future Phases)
# ------------------------------------------------------------------------------
EMAIL_API_KEY="" # e.g., Resend / AWS SES transactional email provider
SMS_API_KEY=""   # e.g., Twilio telephony API key for appointment SMS
PAYMENT_SECRET_KEY="" # e.g., Stripe secret key for billing processing
PAYMENT_PROVIDER="unconfigured" # Keep unconfigured until country, currency, and provider sandbox are approved.
PAYMENT_SETTLEMENT_COUNTRY="" # ISO 3166-1 alpha-2 code; do not guess this value.
PAYMENT_SETTLEMENT_CURRENCY="" # ISO 4217 code supported by the approved provider.
PAYMENT_WEBHOOK_SECRET="" # Provider webhook signing secret; local/staging only.

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
